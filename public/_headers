# Cloudflare Pages — equivalente ao .htaccess (que so a HostGator/Apache le).
# HTTPS e o redirect www->apex ficam por conta da Cloudflare, nao daqui.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=86400

# HTML sempre revalidado: um deploy novo aparece na hora
/index.html
  Cache-Control: no-cache, must-revalidate

# imagens: nomes estaveis, cache longo
/img/*
  Cache-Control: public, max-age=2592000

# vendor/ e versionado (react@18.3.1): cache forte
/site.js
  Cache-Control: public, max-age=604800
