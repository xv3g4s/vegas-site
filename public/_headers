# Cloudflare Pages — equivalente ao .htaccess (que so a HostGator/Apache le).
# HTTPS e o redirect www->apex ficam por conta da Cloudflare, nao daqui.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=86400

# HTML sempre revalidado: um deploy novo aparece na hora
/index.html
  Cache-Control: no-cache, must-revalidate

# imagens: nomes estaveis, cache longo
/img/*
  Cache-Control: public, max-age=2592000

# vendor/ e versionado (react@18.3.1): cache forte
/site.js
  Cache-Control: public, max-age=604800

# ---------- Landing page do Salao Morenos (/morenos/) ----------
/morenos/
  Cache-Control: no-cache, must-revalidate

/morenos/index.html
  Cache-Control: no-cache, must-revalidate

/morenos/img/*
  Cache-Control: public, max-age=2592000

/morenos/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# runtime do Claude Design: react@18.3.1 e um support.js que so muda com o
# proprio runtime — pode ficar em cache forte
/morenos/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/morenos/support.js
  Cache-Control: public, max-age=604800
